# Copy this file to .env and fill in your own values
# .env is gitignored — this file (.env.example) is committed as a template

# Express server port
PORT=3000

# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Docker setup: host port 5433 forwards to container port 5432
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/ecommerce_db?schema=public"
