generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id      Int      @id @default(autoincrement())
  name    String
  email   String   @unique
  address Address? // one-to-one (optional — user may not have an address)
  orders  Order[]  // one-to-many ([] = array = one user can have many orders)
}

// ─── Address (One-to-One with User) ───────────────────────────────────────────
//
// One-to-one is created by putting @unique on the foreign key (userId).
// @unique ensures only ONE Address row can have userId = X.
// Without @unique on userId, this would be one-to-many.
//
model Address {
  id      Int    @id @default(autoincrement())
  street  String
  city    String
  state   String
  country String
  zipCode String

  userId Int    @unique // @unique = this address belongs to exactly one user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── OrderStatus Enum ─────────────────────────────────────────────────────────
//
// An enum means the column can only hold one of these exact values.
// PostgreSQL enforces this — inserting 'INVALID' will throw an error.
// Prisma maps this to a native PostgreSQL ENUM type.
//
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─── Order (One-to-Many from User) ────────────────────────────────────────────
//
// One-to-many = userId has NO @unique.
// Many Order rows can share the same userId.
// One user → many orders. One order → one user.
//
// Compare with Address:
//   Address.userId has @unique    → one-to-one
//   Order.userId   has no @unique → one-to-many
//
model Order {
  id        Int         @id @default(autoincrement())
  total     Decimal     @db.Decimal(10, 2) // exact decimal — never use Float for money
  status    OrderStatus @default(PENDING)   // uses the enum above
  createdAt DateTime    @default(now())     // auto timestamp when row is created

  userId Int  // no @unique = one user can have MANY orders
  user   User @relation(fields: [userId], references: [id])
}

// ─── Category (One-to-Many with Product) ──────────────────────────────────────
//
// One Category has many Products.
// One Product belongs to exactly one Category.
//
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique // category names must be unique (Electronics, Clothing...)
  products Product[]         // back-relation: one category has many products
}

// ─── Product (belongs to Category) ────────────────────────────────────────────
//
// New concepts in this model:
//   String?   → nullable column (NULL allowed in PostgreSQL)
//   Decimal   → exact decimal, not approximate float (important for prices)
//   @default  → column gets this value automatically if not provided
//
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  // ? = optional, maps to TEXT (nullable) in PostgreSQL
  price       Decimal  @db.Decimal(10, 2) // exact — never Float for money
  stock       Int      @default(0)        // new products start at 0 stock
  createdAt   DateTime @default(now())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
}
